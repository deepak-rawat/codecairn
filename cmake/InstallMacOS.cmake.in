set(app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/codecairn.app")
set(clangd "@CODECAIRN_CLANGD@")
set(arguments "${app}" "-executable=${app}/Contents/MacOS/cairn" -always-overwrite -no-plugins)
file(MAKE_DIRECTORY "${app}/Contents/PlugIns/platforms")
file(REAL_PATH "@CODECAIRN_COCOA_PLUGIN@" cocoa_plugin)
file(COPY "${cocoa_plugin}" DESTINATION "${app}/Contents/PlugIns/platforms")
list(APPEND arguments "-executable=${app}/Contents/PlugIns/platforms/libqcocoa.dylib")
get_filename_component(llvm_lib "@LIBCLANG_LIBRARY@" DIRECTORY)
list(APPEND arguments "-libpath=${llvm_lib}")
if(clangd AND EXISTS "${clangd}")
    file(COPY "${clangd}" DESTINATION "${app}/Contents/MacOS")
    list(APPEND arguments "-executable=${app}/Contents/MacOS/clangd")
    get_filename_component(clang_bin "${clangd}" DIRECTORY)
    file(GLOB includes "${clang_bin}/../lib/clang/*/include")
else()
    set(includes "")
endif()
file(GLOB compiler_includes "@codecairn_clang_resource_root@/*/include")
if(NOT compiler_includes)
    message(FATAL_ERROR "No Clang resource headers found in @codecairn_clang_resource_root@")
endif()
list(APPEND includes ${compiler_includes})
foreach(include_dir IN LISTS includes)
    get_filename_component(version_dir "${include_dir}" DIRECTORY)
    get_filename_component(version "${version_dir}" NAME)
    file(COPY "${include_dir}" DESTINATION "${app}/Contents/lib/clang/${version}")
endforeach()
if(@CODECAIRN_RELEASE@)
    set(executables "${app}/Contents/MacOS/codecairn" "${app}/Contents/MacOS/cairn" "${clangd}")
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES ${executables}
         LIBRARIES "@CODECAIRN_COCOA_PLUGIN@"
         RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR unresolved)
    if(unresolved)
        message(FATAL_ERROR "Cannot inventory runtime dependencies: ${unresolved}")
    endif()
    foreach(dependency IN LISTS dependencies)
        if(dependency MATCHES "/(libclang-cpp[^/]*\\.dylib)$")
            set(clang_cpp_name "${CMAKE_MATCH_1}")
            file(REAL_PATH "${dependency}" clang_cpp)
            file(MAKE_DIRECTORY "${app}/Contents/Frameworks")
            file(COPY_FILE "${clang_cpp}" "${app}/Contents/Frameworks/${clang_cpp_name}")
            execute_process(
                COMMAND install_name_tool -change "@rpath/${clang_cpp_name}"
                    "@loader_path/../Frameworks/${clang_cpp_name}" "${app}/Contents/MacOS/clangd"
                COMMAND_ERROR_IS_FATAL ANY
            )
            list(APPEND arguments "-executable=${app}/Contents/Frameworks/${clang_cpp_name}")
        endif()
    endforeach()
    list(SORT dependencies)
    string(REPLACE ";" "\n" dependencies "${dependencies}")
    file(WRITE "${app}/Contents/Resources/RUNTIME-SOURCES.txt" "${dependencies}\n")
endif()
execute_process(COMMAND "@CODECAIRN_MACDEPLOYQT@" ${arguments} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "macdeployqt failed: ${result}")
endif()
file(GLOB_RECURSE frameworks LIST_DIRECTORIES FALSE "${app}/Contents/Frameworks/*")
foreach(library IN LISTS frameworks)
    if(IS_DIRECTORY "${library}" OR IS_SYMLINK "${library}")
        continue()
    endif()
    execute_process(COMMAND otool -D "${library}" RESULT_VARIABLE result
                    OUTPUT_VARIABLE identity ERROR_QUIET)
    if(result EQUAL 0 AND identity MATCHES "/opt/homebrew/|/usr/local/|/Cellar/")
        file(RELATIVE_PATH relative "${app}/Contents/Frameworks" "${library}")
        execute_process(COMMAND install_name_tool -id "@rpath/${relative}" "${library}"
                        COMMAND_ERROR_IS_FATAL ANY)
    endif()
endforeach()
