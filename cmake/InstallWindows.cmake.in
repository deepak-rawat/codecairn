set(EXECUTABLE "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/bin/codecairn.exe")
set(DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/bin")
set(WINDEPLOYQT "@CODECAIRN_WINDEPLOYQT@")
set(QT_BIN "@codecairn_qt_bin@")
set(OBJDUMP "@CMAKE_OBJDUMP@")
set(CLANGD "@CODECAIRN_CLANGD@")
set(CLANG_RESOURCE_ROOT "@codecairn_clang_resource_root@")
set(CLANG_RESOURCE_DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/clang")
include("@codecairn_deploy_script@")
