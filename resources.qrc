        <file alias="codecairn-64.png">assets/icons/codecairn-64.png</file>
        <file alias="codecairn-128.png">assets/icons/codecairn-128.png</file>
        <file alias="codecairn-256.png">assets/icons/codecairn-256.png</file>
        <file alias="codecairn-512.png">assets/icons/codecairn-512.png</file>
