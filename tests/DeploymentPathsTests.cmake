cmake_minimum_required(VERSION 3.24)

function(run)
    execute_process(
        COMMAND ${ARGV}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

# Exercise deployment selection without requiring a native Qt toolchain.
foreach(case linux-ON macos-ON linux-OFF macos-OFF windows-OFF)
    string(REPLACE "-" ";" parts "${case}")
    list(GET parts 0 platform)
    list(GET parts 1 bundle_runtime)
    set(root "${TEST_DIR}/${case}")
    set(is_windows FALSE)
    if(platform STREQUAL "windows")
        set(is_windows TRUE)
    endif()
    if(platform STREQUAL "macos")
        set(is_apple TRUE)
        set(resource_path "codecairn.app/Contents/lib/clang")
    else()
        set(is_apple FALSE)
        set(resource_path "lib/clang")
    endif()
    file(MAKE_DIRECTORY "${root}/source" "${root}/toolchain/lib/clang/23/include")
    file(WRITE "${root}/toolchain/lib/clang/23/include/stddef.h" "/* resource fixture */\n")
    file(WRITE "${root}/source/application" "application fixture\n")
    if(CMAKE_HOST_WIN32)
        set(deploy_stub "${root}/source/macdeployqt.cmd")
        file(WRITE "${deploy_stub}" "@exit /b 0\n")
    else()
        set(deploy_stub "${root}/source/macdeployqt")
        file(WRITE "${deploy_stub}" "#!/bin/sh\nexit 0\n")
        file(CHMOD "${deploy_stub}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endif()
    set(project [=[
