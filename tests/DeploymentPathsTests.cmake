function(qt_generate_deploy_app_script)
    if(NOT CODECAIRN_BUNDLE_RUNTIME)
        message(FATAL_ERROR "Qt deployment must not run in package-managed mode")
    endif()
    cmake_parse_arguments(deploy "NO_TRANSLATIONS" "TARGET;OUTPUT_SCRIPT" "" ${ARGN})
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/qt-deploy.cmake" "")
    set(${deploy_OUTPUT_SCRIPT} "${CMAKE_CURRENT_BINARY_DIR}/qt-deploy.cmake" PARENT_SCOPE)
endfunction()
include("@SOURCE_DIR@/cmake/Deployment.cmake")
if(NOT CODECAIRN_BUNDLE_RUNTIME AND TARGET deploy)
    message(FATAL_ERROR "Package-managed mode must not register a deploy target")
endif()
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/application" DESTINATION bin)
]=])
    string(CONFIGURE "${project}" project @ONLY)
    file(WRITE "${root}/source/CMakeLists.txt" "${project}")
    run(
        "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build" -G Ninja
        "-DCMAKE_INSTALL_PREFIX=${root}/unused-prefix"
    )
    set(prefix "${root}/relocated install")
    set(header "${prefix}/${resource_path}/23/include/stddef.h")
    file(REMOVE "${header}")
    run("${CMAKE_COMMAND}" --install "${root}/build" --prefix "${prefix}")
    if(bundle_runtime AND NOT EXISTS "${header}")
        message(FATAL_ERROR "${case}: Clang headers missing from ${header}")
    elseif(NOT bundle_runtime AND EXISTS "${header}")
        message(FATAL_ERROR "${case}: Clang headers copied in package-managed mode")
    endif()
    if(NOT EXISTS "${prefix}/bin/application")
        message(FATAL_ERROR "${case}: application installation was skipped")
    endif()
    if(NOT bundle_runtime)
        file(GLOB_RECURSE installed_files LIST_DIRECTORIES FALSE "${prefix}/*")
        list(LENGTH installed_files file_count)
        if(NOT file_count EQUAL 1)
            message(FATAL_ERROR "${case}: unexpected deployed files: ${installed_files}")
        endif()
    endif()
    if(EXISTS "${root}/unused-prefix" OR EXISTS "${root}/source/lib")
        message(FATAL_ERROR "${case}: deployment escaped the requested installation prefix")
    endif()
    if(CMAKE_HOST_UNIX)
        run(
            "${CMAKE_COMMAND}" -E env "DESTDIR=${root}/destdir"
            "${CMAKE_COMMAND}" --install "${root}/build" --prefix /opt/codecairn
        )
        if(NOT EXISTS "${root}/destdir/opt/codecairn/bin/application")
            message(FATAL_ERROR "${case}: DESTDIR staging failed")
        endif()
        if(bundle_runtime AND NOT EXISTS "${root}/destdir/opt/codecairn/${resource_path}/23/include/stddef.h")
            message(FATAL_ERROR "${case}: Clang resources ignored DESTDIR")
        endif()
    endif()
endforeach()
