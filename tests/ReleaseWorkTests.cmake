cmake_minimum_required(VERSION 3.24)
include("${SOURCE_DIR}/scripts/ReleaseWork.cmake")
string(RANDOM LENGTH 8 run_id)
set(root "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${root}")

function(fixture name kind finished)
    set(directory "${root}/${name}")
    release_work_start("${directory}" "${kind}" ${ARGN})
    file(MAKE_DIRECTORY "${directory}/build")
    file(WRITE "${directory}/build/symbols.txt" "matching symbols\n")
    if(NOT finished STREQUAL "")
        release_work_complete("${directory}")
        file(READ "${directory}/.codecairn-work.json" metadata)
        string(JSON metadata SET "${metadata}" finished "\"${finished}\"")
        file(WRITE "${directory}/.codecairn-work.json" "${metadata}\n")
    endif()
endfunction()

set(old_mac "release-macos-app-20200101-000000-OldMac")
set(new_mac "release-macos-app-20210101-000000-NewMac")
set(failed "release-macos-app-20220101-000000-Failed")
set(old_windows "release-windows-zip-20200101-000000-OldWin")
set(new_windows "release-windows-zip-20210101-000000-NewWin")
set(old_source "release-source-20200101-000000-OldSrc")
set(new_source "release-source-20210101-000000-NewSrc")
set(tap "local-tap-20200101-000000-OldTap")
fixture("${old_mac}" macos-app "2020-01-01T00:00:00Z")
fixture("${new_mac}" macos-app "2021-01-01T00:00:00Z")
fixture("${failed}" macos-app "")
fixture("${old_windows}" windows-zip "2020-01-01T00:00:00Z")
fixture("${new_windows}" windows-zip "2021-01-01T00:00:00Z")
fixture("${old_source}" source "2020-01-01T00:00:00Z")
fixture("${new_source}" source "2021-01-01T00:00:00Z")
fixture("${tap}" local-tap "2020-01-01T00:00:00Z")

set(legacy "release-macos-app-20190101-000000-Legacy")
file(MAKE_DIRECTORY "${root}/${legacy}")
set(invalid "release-macos-app-20300101-000000-BadJson")
file(MAKE_DIRECTORY "${root}/${invalid}")
file(WRITE "${root}/${invalid}/.codecairn-work.json" "{invalid")
set(copied "release-macos-app-20300101-000000-Copied")
file(MAKE_DIRECTORY "${root}/${copied}")
configure_file("${root}/${new_mac}/.codecairn-work.json"
               "${root}/${copied}/.codecairn-work.json" COPYONLY)
set(bad_paths "release-macos-app-20300101-000000-BadPaths")
fixture("${bad_paths}" macos-app "2030-01-01T00:00:00Z")
file(READ "${root}/${bad_paths}/.codecairn-work.json" metadata)
string(JSON metadata SET "${metadata}" protectedPaths "\"invalid\"")
file(WRITE "${root}/${bad_paths}/.codecairn-work.json" "${metadata}\n")
set(misnamed "release-unrelated-20300101-000000-Wrong")
fixture("${misnamed}" macos-app "2030-01-01T00:00:00Z")
set(protected_output "release-macos-app-20300101-000000-Output")
fixture("${protected_output}" macos-app "2030-01-01T00:00:00Z"
        "${root}/${protected_output}/archives")
file(MAKE_DIRECTORY "${root}/${protected_output}/archives")
file(WRITE "${root}/${protected_output}/archives/app.zip" "final archive\n")
set(protected_tap "local-tap-20300101-000000-TapSafe")
fixture("${protected_tap}" local-tap "2030-01-01T00:00:00Z"
        "${root}/${protected_tap}/tap")
file(MAKE_DIRECTORY "${root}/${protected_tap}/tap")
file(WRITE "${root}/${protected_tap}/tap/formula.rb" "stable tap\n")
foreach(directory releases _deps source-notice-cache)
    file(MAKE_DIRECTORY "${root}/${directory}")
    file(WRITE "${root}/${directory}/keep.txt" "protected data\n")
endforeach()
set(symlink "")
set(marker_symlink "")
if(CMAKE_HOST_UNIX)
    set(symlink "release-macos-app-20300101-000000-Link")
    file(CREATE_LINK "${root}/${new_mac}" "${root}/${symlink}" SYMBOLIC
         RESULT error)
    if(NOT error STREQUAL "0")
        message(FATAL_ERROR "Cannot create symlink safety fixture: ${error}")
    endif()
    file(CREATE_LINK "${root}/_deps" "${root}/${old_mac}/build/cache-link" SYMBOLIC
         RESULT error)
    if(NOT error STREQUAL "0")
        message(FATAL_ERROR "Cannot create nested cache symlink fixture: ${error}")
    endif()
    set(marker_symlink "release-macos-app-20300101-000000-MarkerLink")
    file(MAKE_DIRECTORY "${root}/${marker_symlink}")
    file(CREATE_LINK "${root}/${new_mac}/.codecairn-work.json"
         "${root}/${marker_symlink}/.codecairn-work.json" SYMBOLIC RESULT error)
    if(NOT error STREQUAL "0")
        message(FATAL_ERROR "Cannot create symlinked lifecycle marker fixture: ${error}")
    endif()
endif()

set(prune "${CMAKE_COMMAND}" "-DWORK_ROOT=${root}")
execute_process(COMMAND ${prune} -P "${SOURCE_DIR}/scripts/PruneReleaseWork.cmake"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Preview: 4 completed work directories")
    message(FATAL_ERROR "Prune preview failed: ${output}\n${error}")
endif()
foreach(name "${old_mac}" "${old_windows}" "${old_source}" "${tap}")
    if(NOT EXISTS "${root}/${name}/build/symbols.txt")
        message(FATAL_ERROR "Preview removed work: ${name}")
    endif()
endforeach()

execute_process(COMMAND ${prune} -DAPPLY=ON -P "${SOURCE_DIR}/scripts/PruneReleaseWork.cmake"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Removed 4 completed work directories")
    message(FATAL_ERROR "Pruning failed: ${output}\n${error}")
endif()
foreach(name "${old_mac}" "${old_windows}" "${old_source}" "${tap}")
    if(EXISTS "${root}/${name}")
        message(FATAL_ERROR "Older completed work was not removed: ${name}")
    endif()
endforeach()
foreach(name "${new_mac}" "${new_windows}" "${new_source}" "${failed}")
    file(READ "${root}/${name}/build/symbols.txt" symbols)
    if(NOT symbols STREQUAL "matching symbols\n")
        message(FATAL_ERROR "Latest or failed build/symbols were changed: ${name}")
    endif()
endforeach()
foreach(name "${legacy}" "${invalid}" "${copied}" "${bad_paths}" "${misnamed}"
             "${protected_output}" "${protected_tap}")
    if(NOT IS_DIRECTORY "${root}/${name}")
        message(FATAL_ERROR "Protected or unrecognized directory was removed: ${name}")
    endif()
endforeach()
if(NOT symlink STREQUAL "" AND NOT IS_SYMLINK "${root}/${symlink}")
    message(FATAL_ERROR "Symlinked work directory was not preserved")
endif()
if(NOT marker_symlink STREQUAL "" AND
   NOT IS_SYMLINK "${root}/${marker_symlink}/.codecairn-work.json")
    message(FATAL_ERROR "Symlinked lifecycle marker was not preserved")
endif()
foreach(directory releases _deps source-notice-cache)
    file(READ "${root}/${directory}/keep.txt" content)
    if(NOT content STREQUAL "protected data\n")
        message(FATAL_ERROR "Protected archive/cache was changed: ${directory}")
    endif()
endforeach()
foreach(pair "${protected_output}/archives/app.zip" "${protected_tap}/tap/formula.rb")
    if(NOT EXISTS "${root}/${pair}")
        message(FATAL_ERROR "Protected archive or stable tap was removed: ${pair}")
    endif()
endforeach()
execute_process(COMMAND ${prune} -DAPPLY=ON -P "${SOURCE_DIR}/scripts/PruneReleaseWork.cmake"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Removed 0 completed work directories")
    message(FATAL_ERROR "Pruning was not idempotent: ${output}\n${error}")
endif()
file(WRITE "${root}/unsafe-removal.cmake"
     "include(\"${SOURCE_DIR}/scripts/ReleaseWork.cmake\")\nrelease_work_remove(\"${root}\" \"${root}\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${root}/unsafe-removal.cmake"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Refusing to remove")
    message(FATAL_ERROR "Work-root removal was not refused: ${output}\n${error}")
endif()
message(STATUS "Release work preview, retention, safe pruning, and protected paths verified.")
