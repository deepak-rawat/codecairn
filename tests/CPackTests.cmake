cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 8 run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
find_program(CPACK cpack REQUIRED)
foreach(platform windows linux macos managed)
    set(root "${TEST_DIR}/${platform}")
    file(MAKE_DIRECTORY "${root}/source/packaging")
    configure_file("${SOURCE_DIR}/packaging/PackageMetadata.cmake.in"
                   "${root}/source/packaging/PackageMetadata.cmake.in" COPYONLY)
    set(windows FALSE)
    set(apple FALSE)
    set(bundled TRUE)
    if(platform STREQUAL windows)
        set(windows TRUE)
        set(generator ZIP)
        set(pattern "*.zip")
    elseif(platform STREQUAL macos)
        set(apple TRUE)
        set(generator DragNDrop)
    elseif(platform STREQUAL managed)
        set(bundled FALSE)
    else()
        set(generator TGZ)
        set(pattern "*.tar.gz")
    endif()
    set(project [=[
cmake_minimum_required(VERSION 3.24)
project(PackageFixture VERSION 1.2.3 LANGUAGES NONE)
set(WIN32 @windows@)
set(APPLE @apple@)
set(CODECAIRN_BUNDLE_RUNTIME @bundled@)
set(CODECAIRN_RELEASE OFF)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/application" DESTINATION bin)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/settings" DESTINATION share/codecairn)
include("@SOURCE_DIR@/packaging/CPack.cmake")
]=])
    string(CONFIGURE "${project}" project @ONLY)
    file(WRITE "${root}/source/CMakeLists.txt" "${project}")
    file(WRITE "${root}/source/application" "application fixture\n")
    file(WRITE "${root}/source/settings" "settings fixture\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build" -G Ninja
                    COMMAND_ERROR_IS_FATAL ANY)
    if(NOT bundled)
        if(EXISTS "${root}/build/CPackConfig.cmake")
            message(FATAL_ERROR "Managed build must not enable standalone packaging")
        endif()
        continue()
    endif()
    file(READ "${root}/build/CPackConfig.cmake" config)
    string(FIND "${config}" "set(CPACK_GENERATOR \"${generator}\")" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${platform}: unexpected CPack generator")
    endif()
    if(apple)
        continue()
    endif()
    execute_process(COMMAND "${CPACK}" --config "${root}/build/CPackConfig.cmake"
                    -B "${root}/packages" COMMAND_ERROR_IS_FATAL ANY)
    file(GLOB archives "${root}/packages/${pattern}")
    list(LENGTH archives count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${platform}: expected exactly one CPack archive")
    endif()
    list(GET archives 0 archive)
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${root}/extracted")
    foreach(file bin/application share/codecairn/settings)
        if(NOT EXISTS "${root}/extracted/${file}")
            message(FATAL_ERROR "${platform}: installed package layout is incorrect: ${file}")
        endif()
    endforeach()
    file(SHA256 "${archive}" hash)
    get_filename_component(name "${archive}" NAME)
    file(READ "${archive}.sha256" sidecar)
    if(NOT sidecar STREQUAL "${hash}  ${name}\n")
        message(FATAL_ERROR "${platform}: CPack checksum differs")
    endif()
endforeach()

set(root "${TEST_DIR}/linux-metadata")
file(MAKE_DIRECTORY "${root}/source/packaging" "${root}/stage")
configure_file("${SOURCE_DIR}/packaging/ReleaseCommon.cmake"
               "${root}/source/packaging/ReleaseCommon.cmake" COPYONLY)
file(WRITE "${root}/source/CMakeLists.txt" "project(\n    VERSION 1.2.3\n)\n")
file(WRITE "${root}/source/SOURCE-MANIFEST.txt"
     "revision=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ndirty=false\n")
set(PROJECT_SOURCE_DIR "${root}/source")
set(PROJECT_VERSION 1.2.3)
set(CODECAIRN_RELEASE ON)
set(WIN32 FALSE)
set(APPLE FALSE)
set(CMAKE_SYSTEM_NAME Linux)
set(CODECAIRN_DPKG_QUERY "${root}/missing-dpkg-query")
configure_file("${SOURCE_DIR}/packaging/PackageMetadata.cmake.in"
               "${root}/metadata.cmake" @ONLY)
execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DCMAKE_INSTALL_PREFIX=${root}/stage" -P "${root}/metadata.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(result EQUAL 0 OR NOT error MATCHES "Linux release metadata requires dpkg-query")
    message(FATAL_ERROR "Linux release metadata was skipped or failed unexpectedly: ${output}\n${error}")
endif()
message(STATUS "CPack generators, installed layout, checksums, and managed-mode exclusion verified")
