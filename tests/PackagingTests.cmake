cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 8 run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
set(OUTPUT "${TEST_DIR}/recipes")
include("${SOURCE_DIR}/packaging/ReleaseCommon.cmake")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(archive "${TEST_DIR}/source.tar.gz")
file(WRITE "${archive}" "packaging source fixture\n")
file(SHA256 "${archive}" hash)
set(recipes msys2/PKGBUILD arch/PKGBUILD homebrew/Formula/codecairn.rb)

function(invoke)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
                    OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Packaging command failed: ${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

invoke("${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${OUTPUT}"
       -P "${SOURCE_DIR}/packaging/PrepareRecipes.cmake")
foreach(recipe IN LISTS recipes)
    file(READ "${OUTPUT}/${recipe}" content)
    foreach(expected "${hash}"
        "https://github.com/deepak-rawat/codecairn/releases/download/codecairn-v${VERSION}/codecairn-${VERSION}-source.tar.gz")
        string(FIND "${content}" "${expected}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "${recipe}: wrong public source URL or checksum")
        endif()
    endforeach()
endforeach()
invoke("${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${OUTPUT}"
       -DRELEASE_URL=https://example.invalid/releases/test
       -P "${SOURCE_DIR}/packaging/PrepareRecipes.cmake")
foreach(recipe IN LISTS recipes)
    file(READ "${OUTPUT}/${recipe}" content)
    if(content MATCHES "@[A-Z_]+@" OR content MATCHES "\r")
        message(FATAL_ERROR "${recipe}: unexpanded placeholders or non-Unix line endings")
    endif()
    string(FIND "${content}" "https://example.invalid/releases/test/codecairn-" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${recipe}: wrong custom source URL")
    endif()
endforeach()
file(READ "${OUTPUT}/homebrew/Formula/codecairn.rb" formula)
if(formula MATCHES "bottle do" OR EXISTS "${OUTPUT}/homebrew/Casks")
    message(FATAL_ERROR "Homebrew must remain source-only")
endif()
foreach(expected "\"--parallel\", Hardware::CPU.cores.to_s"
    "system \"/usr/bin/codesign\", \"--force\", \"--sign\", \"-\", prefix/\"codecairn.app\"")
    string(FIND "${formula}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Formula missing build/signing configuration: ${expected}")
    endif()
endforeach()
foreach(platform arch msys2)
    file(READ "${OUTPUT}/${platform}/PKGBUILD" recipe)
    string(FIND "${recipe}" "--parallel \"$(nproc)\"" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${platform}: build does not use all available CPUs")
    endif()
    file(SHA256 "${OUTPUT}/${platform}/codecairn-${VERSION}-source.tar.gz" actual)
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "${platform}: source copy differs")
    endif()
endforeach()

find_program(GIT git REQUIRED)
set(local_root "${TEST_DIR}/local releases")
file(MAKE_DIRECTORY "${local_root}/tap/Formula")
file(WRITE "${local_root}/tap/Formula/another-tool.rb" "another package fixture\n")
set(local_command "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${TEST_DIR}/tap-work"
    "-DLOCAL_ROOT=${local_root}" -DCOMMIT_TAP=ON
    -P "${SOURCE_DIR}/packaging/PrepareLocalTap.cmake")
foreach(iteration RANGE 1 2)
    invoke(${local_command})
    string(REGEX MATCH "Recipes generated in ([^\n;]+); source SHA256=" match "${last_output}")
    if(NOT match OR EXISTS "${CMAKE_MATCH_1}")
        message(FATAL_ERROR "Successful local tap staging was not removed")
    endif()
endforeach()
file(READ "${local_root}/tap/Formula/another-tool.rb" other_package)
if(NOT other_package STREQUAL "another package fixture\n")
    message(FATAL_ERROR "Local tap preparation changed another package")
endif()
file(READ "${local_root}/tap/Formula/codecairn.rb" local_formula)
string(REPLACE " " "%20" artifact_url "file://${local_root}/artifacts/codecairn")
string(FIND "${local_formula}" "${artifact_url}/codecairn-${VERSION}-source.tar.gz" position)
if(position EQUAL -1)
    message(FATAL_ERROR "Local formula does not use stable, encoded artifact URLs")
endif()
file(READ "${local_root}/artifacts/codecairn/codecairn-${VERSION}-source.tar.gz.sha256" sidecar)
if(NOT sidecar STREQUAL "${hash}  codecairn-${VERSION}-source.tar.gz\n")
    message(FATAL_ERROR "Local source checksum differs")
endif()
execute_process(COMMAND "${GIT}" -C "${local_root}/tap" status --porcelain -- Formula/codecairn.rb
                OUTPUT_VARIABLE status COMMAND_ERROR_IS_FATAL ANY)
if(NOT status STREQUAL "")
    message(FATAL_ERROR "Prepared local formula was not committed")
endif()
invoke("${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${TEST_DIR}/tap-work"
       "-DLOCAL_ROOT=${TEST_DIR}/uncommitted-tap"
       -P "${SOURCE_DIR}/packaging/PrepareLocalTap.cmake")
if(EXISTS "${TEST_DIR}/uncommitted-tap/tap/.git")
    message(FATAL_ERROR "Local tap must not commit by default")
endif()

set(nested_root "${TEST_DIR}/nested-repository")
invoke("${GIT}" init "${nested_root}")
invoke("${GIT}" -C "${nested_root}" config core.worktree "${nested_root}")
file(MAKE_DIRECTORY "${nested_root}/tap")
file(WRITE "${nested_root}/tap/.git" "gitdir: ../.git\n")
execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${TEST_DIR}/tap-work"
        "-DLOCAL_ROOT=${nested_root}" -DCOMMIT_TAP=ON
        -P "${SOURCE_DIR}/packaging/PrepareLocalTap.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(result EQUAL 0 OR NOT error MATCHES "Local tap must be its own Git repository")
    message(FATAL_ERROR "Nested tap repository was not rejected: ${output}\n${error}")
endif()

file(APPEND "${local_root}/tap/Formula/codecairn.rb" "# local edit\n")
execute_process(COMMAND ${local_command} RESULT_VARIABLE result
                OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Save or commit local edits")
    message(FATAL_ERROR "Local formula changes were not protected: ${output}\n${error}")
endif()
file(READ "${local_root}/tap/Formula/codecairn.rb" edited_formula)
if(NOT edited_formula MATCHES "# local edit")
    message(FATAL_ERROR "Local edits were overwritten")
endif()
execute_process(COMMAND "${GIT}" -C "${local_root}/tap" show HEAD:Formula/codecairn.rb
                OUTPUT_VARIABLE committed_formula COMMAND_ERROR_IS_FATAL ANY)
file(CONFIGURE OUTPUT "${local_root}/tap/Formula/codecairn.rb"
     CONTENT "${committed_formula}" @ONLY NEWLINE_STYLE UNIX)
file(WRITE "${local_root}/artifacts/codecairn/codecairn-${VERSION}-source.tar.gz" "changed archive\n")
execute_process(COMMAND ${local_command} RESULT_VARIABLE result
                OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Existing release artifact differs")
    message(FATAL_ERROR "Existing source archive was not protected: ${output}\n${error}")
endif()
string(REGEX MATCH "Recipes generated in ([^\n;]+); source SHA256=" match "${output}")
if(NOT match OR NOT IS_DIRECTORY "${CMAKE_MATCH_1}")
    message(FATAL_ERROR "Failed local tap staging was not retained")
endif()

if(CMAKE_HOST_UNIX)
    set(notice_root "${TEST_DIR}/source-notices")
    file(MAKE_DIRECTORY "${notice_root}/fixture/LICENSES" "${notice_root}/installed/1.0")
    file(WRITE "${notice_root}/fixture/LICENSES/MIT.txt" "Fixture license\n")
    invoke("${CMAKE_COMMAND}" -E chdir "${notice_root}" "${CMAKE_COMMAND}" -E tar czf
           "${notice_root}/source.tar.gz" fixture)
    file(SHA256 "${notice_root}/source.tar.gz" source_hash)
    set(metadata "{\"formulae\":[{\"versions\":{\"stable\":\"1.0\"},\"urls\":{\"stable\":{\"url\":\"file://${notice_root}/source.tar.gz\",\"checksum\":\"${source_hash}\"}}}]}")
    file(WRITE "${notice_root}/brew" "#!/bin/sh\nprintf '%s\\n' '${metadata}'\n")
    file(CHMOD "${notice_root}/brew" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    set(BREW "${notice_root}/brew")
    include("${SOURCE_DIR}/packaging/HomebrewNotices.cmake")
    collect_source_notices(fixture "${notice_root}/installed/1.0"
                          "${notice_root}/collected" "${notice_root}/cache")
    file(READ "${notice_root}/collected/fixture/LICENSES/MIT.txt" notice)
    file(READ "${notice_root}/collected/SOURCE.txt" provenance)
    if(NOT notice STREQUAL "Fixture license\n" OR NOT provenance MATCHES "sha256=${source_hash}")
        message(FATAL_ERROR "Verified source notices or provenance were not preserved")
    endif()
endif()
message(STATUS "Recipes, local tap protection, and dependency notices verified")
