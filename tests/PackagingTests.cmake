cmake_minimum_required(VERSION 3.24)
string(RANDOM LENGTH 8 run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(archive "${TEST_DIR}/source.tar.gz")
file(WRITE "${archive}" "packaging source fixture\n")
file(SHA256 "${archive}" hash)
set(app_archive "${TEST_DIR}/codecairn-0.1.0-macos26-arm64-unsigned.zip")
file(WRITE "${app_archive}" "macOS app archive fixture\n")
file(MAKE_DIRECTORY "${TEST_DIR}/recipes")
configure_file("${app_archive}" "${TEST_DIR}/recipes/codecairn-0.1.0-macos26-arm64-unsigned.zip" COPYONLY)
execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${TEST_DIR}/recipes"
            -P "${SOURCE_DIR}/scripts/PrepareRecipes.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Default recipe generation failed: ${output}\n${error}")
endif()
foreach(recipe msys2/PKGBUILD arch/PKGBUILD codecairn.rb arch/.SRCINFO)
    file(READ "${TEST_DIR}/recipes/${recipe}" content)
    foreach(expected "https://github.com/deepak-rawat/codecairn/releases/download/codecairn-v0.1.0/codecairn-0.1.0-source.tar.gz"
                     "https://github.com/deepak-rawat/codecairn")
        string(FIND "${content}" "${expected}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "${recipe}: incorrect default repository URL: ${expected}")
        endif()
    endforeach()
endforeach()
execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${TEST_DIR}/recipes"
            -DRELEASE_URL=https://example.invalid/releases/test
            -P "${SOURCE_DIR}/scripts/PrepareRecipes.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Recipe generation failed: ${output}\n${error}")
endif()
set(OUTPUT "${TEST_DIR}/parallelism")
include("${SOURCE_DIR}/scripts/ReleaseCommon.cmake")
unset(JOBS)
release_build_jobs(detected_jobs)
include(ProcessorCount)
ProcessorCount(expected_jobs)
if(NOT detected_jobs EQUAL expected_jobs OR detected_jobs LESS 1)
    message(FATAL_ERROR "Default release parallelism does not match available CPUs")
endif()
set(JOBS 3)
release_build_jobs(explicit_jobs)
if(NOT explicit_jobs EQUAL 3)
    message(FATAL_ERROR "Explicit release parallelism was not preserved")
endif()
unset(JOBS)
file(WRITE "${TEST_DIR}/invalid-jobs.cmake"
     "set(OUTPUT \"${TEST_DIR}/invalid-jobs\")\ninclude(\"${SOURCE_DIR}/scripts/ReleaseCommon.cmake\")\nset(JOBS 0)\nrelease_build_jobs(jobs)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${TEST_DIR}/invalid-jobs.cmake"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "JOBS must be a positive integer")
    message(FATAL_ERROR "Invalid release parallelism was not rejected: ${output}\n${error}")
endif()
foreach(recipe msys2/PKGBUILD arch/PKGBUILD codecairn.rb arch/.SRCINFO)
    file(READ "${TEST_DIR}/recipes/${recipe}" content)
    if(content MATCHES "@VERSION@|@SHA256@|@SOURCE_URL@|@BOTTLE_BLOCK@" OR content MATCHES "\r")
        message(FATAL_ERROR "${recipe}: unexpanded placeholders or non-Unix line endings")
    endif()
    string(FIND "${content}" "${hash}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${recipe}: incorrect source checksum")
    endif()
    if(NOT content MATCHES "https://example.invalid/releases/test/codecairn-")
        message(FATAL_ERROR "${recipe}: incorrect source URL")
    endif()
    string(FIND "${content}" "https://github.com/deepak-rawat/codecairn" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${recipe}: incorrect repository homepage")
    endif()
endforeach()
file(READ "${TEST_DIR}/recipes/homebrew/Formula/codecairn.rb" formula)
file(READ "${TEST_DIR}/recipes/codecairn.rb" original_formula)
if(NOT formula STREQUAL original_formula)
    message(FATAL_ERROR "Tap formula differs from standalone formula")
endif()
if(formula MATCHES "bottle do|@BOTTLE_BLOCK@")
    message(FATAL_ERROR "Homebrew formula must be source-only")
endif()
foreach(expected "\"--parallel\", Hardware::CPU.cores.to_s"
                 "system \"/usr/bin/codesign\", \"--force\", \"--sign\", \"-\", prefix/\"codecairn.app\"")
    string(FIND "${formula}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Formula missing build configuration: ${expected}")
    endif()
endforeach()
foreach(platform arch msys2)
    file(READ "${TEST_DIR}/recipes/${platform}/PKGBUILD" recipe)
    string(FIND "${recipe}" "--parallel \"$(nproc)\"" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${platform} recipe does not build with all available CPUs")
    endif()
endforeach()
if(EXISTS "${TEST_DIR}/recipes/homebrew/Casks")
    message(FATAL_ERROR "macOS recipes must expose only the Homebrew formula, not a cask")
endif()
foreach(script PrepareRecipes PrepareLocalTap)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${TEST_DIR}/invalid-recipes"
                "-DLOCAL_ROOT=${TEST_DIR}/invalid-tap" "-DBOTTLE_JSON=${TEST_DIR}/obsolete.json"
                -P "${SOURCE_DIR}/scripts/${script}.cmake"
        RESULT_VARIABLE invalid_result OUTPUT_VARIABLE invalid_output ERROR_VARIABLE invalid_error
    )
    if(invalid_result EQUAL 0 OR NOT invalid_error MATCHES "BOTTLE_JSON is no longer supported")
        message(FATAL_ERROR "${script} did not reject the removed bottle option: ${invalid_output}\n${invalid_error}")
    endif()
endforeach()
foreach(platform arch msys2)
    file(GLOB sources "${TEST_DIR}/recipes/${platform}/*-source.tar.gz")
    list(LENGTH sources count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${platform}: missing or ambiguous local source archive")
    endif()
    list(GET sources 0 source)
    file(SHA256 "${source}" actual)
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "${platform}: local source copy is not identical")
    endif()
endforeach()
find_program(GIT git REQUIRED)
set(local_root "${TEST_DIR}/local releases")
file(MAKE_DIRECTORY "${local_root}/tap/Formula")
file(WRITE "${local_root}/tap/Formula/another-tool.rb" "another package fixture\n")
file(WRITE "${local_root}/tap/Formula/codecairn.rb"
     "class Codecairn < Formula\n  bottle do\n    root_url \"file:///old-artifacts\"\n  end\nend\n")
file(MAKE_DIRECTORY "${local_root}/artifacts/codecairn")
file(WRITE "${local_root}/artifacts/codecairn/legacy.bottle.tar.gz" "preserved legacy archive\n")
execute_process(COMMAND "${GIT}" init "${local_root}/tap" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT}" -C "${local_root}/tap" add -- Formula/codecairn.rb
                COMMAND_ERROR_IS_FATAL ANY)
execute_process(
    COMMAND "${GIT}" -C "${local_root}/tap" -c "user.name=Packaging Test"
            -c "user.email=test@localhost" commit -m "Existing bottle formula"
    COMMAND_ERROR_IS_FATAL ANY
)
set(local_command "${CMAKE_COMMAND}" "-DARCHIVE=${archive}"
                  "-DLOCAL_ROOT=${local_root}" -DCOMMIT_TAP=ON
                  "-DWORK_ROOT=${TEST_DIR}/work"
                  -P "${SOURCE_DIR}/scripts/PrepareLocalTap.cmake")
function(assert_tap_staging_removed output)
    string(REGEX MATCH "Recipes generated in ([^\n;]+); source SHA256=" match "${output}")
    if(NOT match OR EXISTS "${CMAKE_MATCH_1}")
        message(FATAL_ERROR "Successful local tap staging was not removed: ${output}")
    endif()
    cmake_path(IS_PREFIX TEST_DIR "${CMAKE_MATCH_1}" NORMALIZE isolated)
    if(NOT isolated)
        message(FATAL_ERROR "Packaging staging escaped its test fixture: ${output}")
    endif()
endfunction()
foreach(iteration RANGE 1 2)
    execute_process(COMMAND ${local_command}
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Local tap preparation failed: ${output}\n${error}")
    endif()
    assert_tap_staging_removed("${output}")
endforeach()
file(READ "${local_root}/tap/Formula/another-tool.rb" other_package)
if(NOT other_package STREQUAL "another package fixture\n")
    message(FATAL_ERROR "Local tap preparation changed another package")
endif()
file(READ "${local_root}/tap/Formula/codecairn.rb" local_formula)
string(REPLACE " " "%20" artifact_url "file://${local_root}/artifacts/codecairn")
foreach(expected "${artifact_url}/codecairn-0.1.0-source.tar.gz")
    string(FIND "${local_formula}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Local formula does not use stable artifact paths: ${expected}")
    endif()
endforeach()
if(local_formula MATCHES "bottle do|@BOTTLE_BLOCK@")
    message(FATAL_ERROR "Local tap formula must be source-only")
endif()
file(READ "${local_root}/artifacts/codecairn/legacy.bottle.tar.gz" legacy_archive)
if(NOT legacy_archive STREQUAL "preserved legacy archive\n")
    message(FATAL_ERROR "Legacy archive was deleted or changed during source-only migration")
endif()
if(EXISTS "${local_root}/tap/Casks")
    message(FATAL_ERROR "Local tap must not generate a cask")
endif()
foreach(name codecairn-0.1.0-source.tar.gz)
    file(SHA256 "${local_root}/artifacts/codecairn/${name}" artifact_hash)
    file(READ "${local_root}/artifacts/codecairn/${name}.sha256" sidecar)
    if(NOT sidecar STREQUAL "${artifact_hash}  ${name}\n")
        message(FATAL_ERROR "Stable artifact checksum mismatch for ${name}")
    endif()
endforeach()
execute_process(COMMAND "${GIT}" -C "${local_root}/tap" status --porcelain -- Formula/codecairn.rb
                OUTPUT_VARIABLE status COMMAND_ERROR_IS_FATAL ANY)
if(NOT status STREQUAL "")
    message(FATAL_ERROR "Prepared local formula was not committed")
endif()
set(source_root "${TEST_DIR}/source-only")
execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DLOCAL_ROOT=${source_root}"
            "-DWORK_ROOT=${TEST_DIR}/work"
            -P "${SOURCE_DIR}/scripts/PrepareLocalTap.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Source-only tap preparation failed: ${output}\n${error}")
endif()
assert_tap_staging_removed("${output}")
file(READ "${source_root}/tap/Formula/codecairn.rb" source_formula)
if(source_formula MATCHES "bottle do|@BOTTLE_BLOCK@" OR EXISTS "${source_root}/tap/.git")
    message(FATAL_ERROR "Source-only preparation must not add bottle metadata or commit by default")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DLOCAL_ROOT=${source_root}"
            "-DWORK_ROOT=${TEST_DIR}/work"
            -DCOMMIT_TAP=ON -P "${SOURCE_DIR}/scripts/PrepareLocalTap.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Committing a reviewed source-only formula failed: ${output}\n${error}")
endif()
assert_tap_staging_removed("${output}")
file(APPEND "${local_root}/tap/Formula/codecairn.rb" "# local edit\n")
execute_process(COMMAND ${local_command}
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Save or commit local edits")
    message(FATAL_ERROR "Local formula changes were not protected: ${output}\n${error}")
endif()
file(READ "${local_root}/tap/Formula/codecairn.rb" edited_formula)
if(NOT edited_formula MATCHES "# local edit")
    message(FATAL_ERROR "Local formula edits were overwritten")
endif()
execute_process(COMMAND "${GIT}" -C "${local_root}/tap" show HEAD:Formula/codecairn.rb
                OUTPUT_VARIABLE committed_formula COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${local_root}/tap/Formula/codecairn.rb" "${committed_formula}")
file(WRITE "${local_root}/artifacts/codecairn/codecairn-0.1.0-source.tar.gz" "changed archive\n")
execute_process(COMMAND ${local_command}
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Existing release artifact differs")
    message(FATAL_ERROR "Existing release archive was not protected: ${output}\n${error}")
endif()
string(REGEX MATCH "Recipes generated in ([^\n;]+); source SHA256=" match "${output}")
if(NOT match OR NOT EXISTS "${CMAKE_MATCH_1}/.codecairn-work.json")
    message(FATAL_ERROR "Failed local tap staging was not retained: ${output}")
endif()
file(READ "${CMAKE_MATCH_1}/.codecairn-work.json" failed_work)
string(JSON failed_status GET "${failed_work}" status)
if(NOT failed_status STREQUAL "incomplete")
    message(FATAL_ERROR "Failed local tap preparation was marked successful")
endif()
if(CMAKE_HOST_UNIX)
    set(notice_root "${TEST_DIR}/source-notices")
    file(MAKE_DIRECTORY "${notice_root}/fixture/LICENSES" "${notice_root}/installed/1.0")
    file(WRITE "${notice_root}/fixture/LICENSES/MIT.txt" "Fixture license\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${notice_root}/source.tar.gz" fixture
                    WORKING_DIRECTORY "${notice_root}" COMMAND_ERROR_IS_FATAL ANY)
    file(SHA256 "${notice_root}/source.tar.gz" source_hash)
    set(metadata "{\"formulae\":[{\"versions\":{\"stable\":\"1.0\"},\"urls\":{\"stable\":{\"url\":\"file://${notice_root}/source.tar.gz\",\"checksum\":\"${source_hash}\"}}}]}")
    file(WRITE "${notice_root}/brew" "#!/bin/sh\nprintf '%s\\n' '${metadata}'\n")
    file(CHMOD "${notice_root}/brew" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    set(BREW "${notice_root}/brew")
    include("${SOURCE_DIR}/scripts/HomebrewNotices.cmake")
    collect_source_notices("fixture" "${notice_root}/installed/1.0"
                           "${notice_root}/collected" "${notice_root}/cache")
    file(READ "${notice_root}/collected/fixture/LICENSES/MIT.txt" notice)
    if(NOT notice STREQUAL "Fixture license\n")
        message(FATAL_ERROR "Verified source notices were not preserved")
    endif()
    file(READ "${notice_root}/collected/SOURCE.txt" provenance)
    if(NOT provenance MATCHES "sha256=${source_hash}")
        message(FATAL_ERROR "Source notice provenance is missing")
    endif()
endif()
message(STATUS "Recipe checksums, source URLs, source copies, and Unix line endings verified.")
