include("${CMAKE_CURRENT_LIST_DIR}/ReleaseWork.cmake")
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED WORK_ROOT)
    set(WORK_ROOT "${source}/build")
endif()
if(NOT IS_DIRECTORY "${WORK_ROOT}")
    message(FATAL_ERROR "Release work root does not exist: ${WORK_ROOT}")
endif()
file(REAL_PATH "${WORK_ROOT}" WORK_ROOT)
set(protected "${source}/build/releases" "${source}/build/_deps"
              "${WORK_ROOT}/releases" "${WORK_ROOT}/_deps"
              "${WORK_ROOT}/source-notice-cache")
if(NOT "$ENV{HOME}" STREQUAL "")
    list(APPEND protected "$ENV{HOME}/local-releases")
endif()
file(GLOB directories LIST_DIRECTORIES TRUE
     "${WORK_ROOT}/release-*" "${WORK_ROOT}/local-tap-*")
set(completed "")
foreach(directory IN LISTS directories)
    if(NOT IS_DIRECTORY "${directory}")
        continue()
    endif()
    release_work_read("${directory}" metadata)
    if(NOT metadata)
        continue()
    endif()
    string(JSON kind GET "${metadata}" kind)
    string(JSON status GET "${metadata}" status)
    if(NOT status STREQUAL "complete")
        message(STATUS "Keeping failed, incomplete, or active work: ${directory}")
        continue()
    endif()
    release_work_removable("${directory}" "${WORK_ROOT}" removable ${protected})
    if(NOT removable)
        continue()
    endif()
    list(APPEND completed "${directory}")
    if(NOT kind STREQUAL "local-tap")
        string(JSON finished GET "${metadata}" finished)
        set(order "${finished}|${directory}")
        if(NOT DEFINED latest_order_${kind} OR order STRGREATER latest_order_${kind})
            set(latest_order_${kind} "${order}")
            set(latest_${kind} "${directory}")
        endif()
    endif()
endforeach()
set(count 0)
foreach(directory IN LISTS completed)
    release_work_read("${directory}" metadata)
    string(JSON kind GET "${metadata}" kind)
    if(DEFINED latest_${kind} AND directory STREQUAL latest_${kind})
        message(STATUS "Keeping latest successful ${kind} work and symbols: ${directory}")
        continue()
    endif()
    release_work_removable("${directory}" "${WORK_ROOT}" removable ${protected})
    if(NOT removable)
        continue()
    endif()
    math(EXPR count "${count} + 1")
    if(APPLY)
        release_work_remove("${directory}" "${WORK_ROOT}" ${protected})
    else()
        message(STATUS "Would remove completed work: ${directory}")
    endif()
endforeach()
if(APPLY)
    message(STATUS "Removed ${count} completed work directories.")
else()
    message(STATUS "Preview: ${count} completed work directories eligible; use -DAPPLY=ON to remove.")
endif()
