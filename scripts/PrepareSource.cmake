include("${CMAKE_CURRENT_LIST_DIR}/ReleaseCommon.cmake")
if(EXISTS "${SOURCE}/SOURCE-MANIFEST.txt")
    message(FATAL_ERROR "PrepareSource must run from a Git checkout, not an unpacked source archive.")
endif()
if(DIRTY AND NOT ALLOW_DIRTY)
    message(FATAL_ERROR "Commit release inputs first, or use -DALLOW_DIRTY=ON for a local snapshot.")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 6 random)
set(work "${SOURCE}/build/release-source-${stamp}-${random}")
release_work_start("${work}" source "${OUTPUT}")
set(root "${work}/codecairn-${VERSION}")
file(MAKE_DIRECTORY "${root}")
execute_process(
    COMMAND "${GIT}" -C "${SOURCE}" ls-files --cached --others --exclude-standard -- .
    OUTPUT_VARIABLE files OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY
)
string(REPLACE "\n" ";" files "${files}")
foreach(file IN LISTS files)
    if(NOT EXISTS "${SOURCE}/${file}")
        message(FATAL_ERROR "Tracked source is missing: ${file}")
    endif()
    get_filename_component(directory "${file}" DIRECTORY)
    file(MAKE_DIRECTORY "${root}/${directory}")
    file(COPY "${SOURCE}/${file}" DESTINATION "${root}/${directory}")
endforeach()

function(codecairn_source name override url hash)
    set(archive "${work}/${name}.tar.gz")
    file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON)
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}/unpacked-${name}")
    file(GLOB children LIST_DIRECTORIES TRUE "${work}/unpacked-${name}/*")
    list(LENGTH children count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one source root in ${name}")
    endif()
    list(GET children 0 unpacked)
    foreach(required IN LISTS ARGN)
        if(NOT EXISTS "${unpacked}/${required}")
            message(FATAL_ERROR "${name}: archive missing ${required}")
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${root}/vendor/${name}")
    file(COPY "${unpacked}/" DESTINATION "${root}/vendor/${name}")
    file(APPEND "${root}/SOURCE-MANIFEST.txt" "${name} ${hash} ${url}\n")
endfunction()

file(WRITE "${root}/SOURCE-MANIFEST.txt" "CodeCairn ${VERSION}\nrevision=${REVISION}\ndirty=${DIRTY}\n")
include("${SOURCE}/cmake/SourceArchives.cmake")
set(archive "${OUTPUT}/codecairn-${VERSION}-source.tar.gz")
run("${CMAKE_COMMAND}" -E chdir "${work}" "${CMAKE_COMMAND}" -E tar czf "${archive}"
    --format=gnutar "codecairn-${VERSION}")
checksum("${archive}")
release_work_complete("${work}")
message(STATUS "Source distribution: ${archive}")
