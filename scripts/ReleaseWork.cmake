cmake_minimum_required(VERSION 3.24)
include_guard(GLOBAL)

function(release_work_string value result)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(release_work_start directory kind)
    if(NOT kind MATCHES "^(local-tap|source|macos-app|windows-zip)$")
        message(FATAL_ERROR "Unknown release work kind: ${kind}")
    endif()
    if(EXISTS "${directory}" OR IS_SYMLINK "${directory}")
        message(FATAL_ERROR "Refusing to reuse an existing release work directory: ${directory}")
    endif()
    file(MAKE_DIRECTORY "${directory}")
    file(REAL_PATH "${directory}" directory)
    string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
    set(metadata "{\"schemaVersion\":1,\"status\":\"incomplete\",\"protectedPaths\":[]}")
    foreach(key directory kind started)
        release_work_string("${${key}}" value)
        string(JSON metadata SET "${metadata}" "${key}" "${value}")
    endforeach()
    set(index 0)
    foreach(path IN LISTS ARGN)
        get_filename_component(path "${path}" ABSOLUTE)
        release_work_string("${path}" value)
        string(JSON metadata SET "${metadata}" protectedPaths ${index} "${value}")
        math(EXPR index "${index} + 1")
    endforeach()
    file(WRITE "${directory}/.codecairn-work.json" "${metadata}\n")
endfunction()

function(release_work_read directory result)
    set(${result} "" PARENT_SCOPE)
    set(marker "${directory}/.codecairn-work.json")
    if(IS_SYMLINK "${directory}" OR IS_SYMLINK "${marker}" OR
       IS_DIRECTORY "${marker}" OR NOT EXISTS "${marker}")
        message(STATUS "Preserving unmarked or symlinked work directory: ${directory}")
        return()
    endif()
    file(SIZE "${marker}" size)
    if(size GREATER 65536)
        message(WARNING "Preserving work with oversized lifecycle metadata: ${directory}")
        return()
    endif()
    file(READ "${marker}" metadata)
    foreach(key schemaVersion directory kind status protectedPaths)
        string(JSON ${key} ERROR_VARIABLE error GET "${metadata}" "${key}")
        if(error)
            message(WARNING "Preserving work with invalid lifecycle metadata: ${directory}")
            return()
        endif()
    endforeach()
    # The recorded path prevents copied markers from authorizing another directory.
    file(REAL_PATH "${ARGV0}" actual)
    if(NOT schemaVersion STREQUAL "1" OR NOT directory STREQUAL actual OR
       NOT kind MATCHES "^(local-tap|source|macos-app|windows-zip)$" OR
       NOT status MATCHES "^(incomplete|complete)$")
        message(WARNING "Preserving work with mismatched lifecycle metadata: ${ARGV0}")
        return()
    endif()
    string(JSON paths_type TYPE "${metadata}" protectedPaths)
    if(NOT paths_type STREQUAL "ARRAY")
        message(WARNING "Preserving work with invalid protected paths: ${ARGV0}")
        return()
    endif()
    string(JSON count LENGTH "${metadata}" protectedPaths)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON type TYPE "${metadata}" protectedPaths ${index})
            string(JSON path GET "${metadata}" protectedPaths ${index})
            if(NOT type STREQUAL "STRING" OR NOT IS_ABSOLUTE "${path}")
                message(WARNING "Preserving work with invalid protected path: ${ARGV0}")
                return()
            endif()
        endforeach()
    endif()
    if(status STREQUAL "complete")
        string(JSON finished ERROR_VARIABLE error GET "${metadata}" finished)
        if(error OR NOT finished MATCHES "^[0-9-]+T[0-9:.]+Z$")
            message(WARNING "Preserving work with invalid completion time: ${ARGV0}")
            return()
        endif()
    endif()
    set(${result} "${metadata}" PARENT_SCOPE)
endfunction()

function(release_work_complete directory)
    release_work_read("${directory}" metadata)
    if(NOT metadata)
        message(FATAL_ERROR "Cannot complete unrecognized release work: ${directory}")
    endif()
    string(TIMESTAMP finished "%Y-%m-%dT%H:%M:%S.%fZ" UTC)
    string(JSON metadata SET "${metadata}" status "\"complete\"")
    string(JSON metadata SET "${metadata}" finished "\"${finished}\"")
    file(WRITE "${directory}/.codecairn-work.json" "${metadata}\n")
endfunction()

function(release_work_removable directory root result)
    set(${result} FALSE PARENT_SCOPE)
    release_work_read("${directory}" metadata)
    if(NOT metadata)
        return()
    endif()
    file(REAL_PATH "${root}" root)
    file(REAL_PATH "${directory}" directory)
    get_filename_component(parent "${directory}" DIRECTORY)
    get_filename_component(name "${directory}" NAME)
    string(JSON kind GET "${metadata}" kind)
    string(JSON status GET "${metadata}" status)
    if(kind STREQUAL "local-tap")
        set(prefix "local-tap")
    else()
        set(prefix "release-${kind}")
    endif()
    if(NOT parent STREQUAL root OR NOT status STREQUAL "complete" OR
       NOT name MATCHES "^${prefix}-[0-9]+-[0-9]+-[a-zA-Z0-9]+$")
        message(STATUS "Preserving incomplete or out-of-scope work: ${directory}")
        return()
    endif()
    set(protected ${ARGN})
    string(JSON count LENGTH "${metadata}" protectedPaths)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON path GET "${metadata}" protectedPaths ${index})
            list(APPEND protected "${path}")
        endforeach()
    endif()
    foreach(path IN LISTS protected)
        file(REAL_PATH "${path}" path)
        cmake_path(IS_PREFIX directory "${path}" NORMALIZE contains_protected)
        cmake_path(IS_PREFIX path "${directory}" NORMALIZE inside_protected)
        if(contains_protected OR inside_protected)
            message(STATUS "Preserving work overlapping a protected location: ${directory}")
            return()
        endif()
    endforeach()
    set(${result} TRUE PARENT_SCOPE)
endfunction()

function(release_work_remove directory root)
    release_work_removable("${directory}" "${root}" removable ${ARGN})
    if(NOT removable)
        message(FATAL_ERROR "Refusing to remove protected or unrecognized work: ${directory}")
    endif()
    file(REAL_PATH "${directory}" directory)
    message(STATUS "Removing completed work: ${directory}")
    file(REMOVE_RECURSE "${directory}")
    if(EXISTS "${directory}")
        message(FATAL_ERROR "Could not remove release work directory: ${directory}")
    endif()
endfunction()
