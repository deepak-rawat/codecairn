include("${CMAKE_CURRENT_LIST_DIR}/ReleaseCommon.cmake")
release_build_jobs(JOBS)
message(STATUS "Build parallelism: ${JOBS} jobs")
if("${TARGET}" STREQUAL "windows-all")
    if(NOT CMAKE_HOST_WIN32)
        message(FATAL_ERROR "windows-all requires a Windows UCRT64 host.")
    endif()
    if(DIRTY AND NOT ALLOW_DIRTY)
        message(FATAL_ERROR "Commit release inputs first, or use -DALLOW_DIRTY=ON for a local snapshot.")
    endif()
    run("${CMAKE_COMMAND}" "-DOUTPUT=${OUTPUT}" "-DALLOW_DIRTY=${ALLOW_DIRTY}"
        -P "${SOURCE}/scripts/PrepareSource.cmake")
    run("${CMAKE_COMMAND}" "-DOUTPUT=${OUTPUT}" -P "${SOURCE}/scripts/PrepareRecipes.cmake")
    run("${CMAKE_COMMAND}" -DTARGET=windows-zip "-DOUTPUT=${OUTPUT}" "-DJOBS=${JOBS}"
        -P "${CMAKE_CURRENT_LIST_FILE}")
    find_program(BASH bash HINTS C:/msys64/usr/bin REQUIRED)
    set(ENV{MSYSTEM} UCRT64)
    set(ENV{CHERE_INVOKING} 1)
    set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} "${JOBS}")
    run("${CMAKE_COMMAND}" -E chdir "${OUTPUT}/msys2" "${BASH}" -lc
        "makepkg-mingw --syncdeps --noconfirm --cleanbuild --force")
    set(package "${OUTPUT}/msys2/mingw-w64-ucrt-x86_64-codecairn-${VERSION}-1-any.pkg.tar.zst")
    if(NOT EXISTS "${package}")
        message(FATAL_ERROR "Expected MSYS2 package was not produced: ${package}")
    endif()
    checksum("${package}")
    return()
endif()
if(NOT "${TARGET}" MATCHES "^(windows-zip|macos-app)$")
    message(FATAL_ERROR "Specify -DTARGET=windows-all, windows-zip, or macos-app; use the native recipes for other managed packages.")
endif()
if("${TARGET}" STREQUAL "windows-zip" AND NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "The Windows release requires a Windows UCRT64 host.")
elseif("${TARGET}" STREQUAL "macos-app" AND NOT CMAKE_HOST_APPLE)
    message(FATAL_ERROR "The macOS release requires a macOS 26+ ARM64 host.")
endif()
if(CMAKE_HOST_APPLE)
    execute_process(COMMAND uname -m OUTPUT_VARIABLE architecture OUTPUT_STRIP_TRAILING_WHITESPACE
                    COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND sw_vers -productVersion OUTPUT_VARIABLE os_version OUTPUT_STRIP_TRAILING_WHITESPACE
                    COMMAND_ERROR_IS_FATAL ANY)
    if(NOT architecture STREQUAL "arm64" OR os_version VERSION_LESS 26)
        message(FATAL_ERROR "Use native Apple Silicon macOS 26 or newer.")
    endif()
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 6 random)
set(work "${SOURCE}/build/release-${TARGET}-${stamp}-${random}")
release_work_start("${work}" "${TARGET}" "${OUTPUT}")
set(binary "${work}/build")
set(stage "${work}/stage")
set(options -DCMAKE_BUILD_TYPE=Release -DCODECAIRN_RELEASE=ON
            -DCODECAIRN_BUNDLE_RUNTIME=ON -DBUILD_TESTING=ON)
if(CMAKE_HOST_WIN32)
    list(APPEND options -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++)
else()
    find_program(BREW brew REQUIRED)
    set(prefixes "")
    foreach(package qt tree-sitter sqlite re2 llvm)
        execute_process(COMMAND "${BREW}" --prefix "${package}" OUTPUT_VARIABLE prefix
                        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        list(APPEND prefixes "${prefix}")
    endforeach()
    string(REPLACE ";" ":" prefix_search "${prefixes}")
    set(ENV{CMAKE_PREFIX_PATH} "${prefix_search}")
endif()
run("${CMAKE_COMMAND}" -S "${SOURCE}" -B "${binary}" -G Ninja ${options})
set(targets codecairn cairn launcher_tests startup_tests)
if(CMAKE_HOST_WIN32)
    list(APPEND targets deploy)
endif()
run("${CMAKE_COMMAND}" --build "${binary}" --target ${targets} --parallel "${JOBS}")
find_program(CTEST ctest REQUIRED)
run("${CTEST}" --test-dir "${binary}" --output-on-failure
    -R "^(application_version|application_help|launcher|launcher_version|startup|deployment_paths|packaging|release_work|windows_runtime)$")
run("${CMAKE_COMMAND}" --install "${binary}" --prefix "${stage}")
file(WRITE "${stage}/BUILD-MANIFEST.txt"
     "CodeCairn ${VERSION}\nrevision=${REVISION}\ndirty=${DIRTY}\ntarget=${TARGET}\ncmake=${CMAKE_VERSION}\n")
if(CMAKE_HOST_WIN32)
    include("${binary}/CMakeFiles/${CMAKE_VERSION}/CMakeCXXCompiler.cmake")
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT CMAKE_CXX_SIZEOF_DATA_PTR EQUAL 8)
        message(FATAL_ERROR "Windows releases require an x64 toolchain.")
    endif()
    find_program(PACMAN pacman HINTS C:/msys64/usr/bin REQUIRED)
    execute_process(COMMAND "${PACMAN}" -Q OUTPUT_FILE "${stage}/DEPENDENCIES.txt"
                    COMMAND_ERROR_IS_FATAL ANY)
    get_filename_component(compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    set(license_root "${compiler_bin}/../share/licenses")
    if(NOT EXISTS "${license_root}/qt6-base/LGPL-3.0-only.txt")
        message(FATAL_ERROR "MSYS2 dependency license texts missing: ${license_root}")
    endif()
    file(COPY "${license_root}/" DESTINATION "${stage}/share/codecairn/licenses/runtime")
    file(COPY "${SOURCE}/packaging/THIRD-PARTY-NOTICES.txt"
         DESTINATION "${stage}/share/codecairn/licenses")
    find_program(OBJDUMP objdump REQUIRED)
    run("${CMAKE_COMMAND}" "-DEXECUTABLE=${stage}/bin/codecairn.exe"
        "-DCLANG_RESOURCE_DESTINATION=${stage}/lib/clang" "-DOBJDUMP=${OBJDUMP}"
        "-DEXPECTED_VERSION=${VERSION}"
        "-DTEST_DIRECTORY=${work}/installed-runtime-check"
        -P "${SOURCE}/cmake/VerifyWindowsRuntime.cmake")
    run("${stage}/bin/cairn.exe" --version)
    set(artifact "${OUTPUT}/codecairn-${VERSION}-windows11-x64.zip")
    run("${CMAKE_COMMAND}" -E chdir "${stage}" "${CMAKE_COMMAND}" -E tar cf "${artifact}"
        --format=zip bin lib share BUILD-MANIFEST.txt DEPENDENCIES.txt)
else()
    set(app "${stage}/codecairn.app")
    set(resources "${app}/Contents/Resources")
    file(COPY "${stage}/BUILD-MANIFEST.txt" DESTINATION "${resources}")
    file(COPY "${SOURCE}/packaging/THIRD-PARTY-NOTICES.txt"
         DESTINATION "${resources}/share/codecairn/licenses")
    execute_process(COMMAND "${BREW}" list --versions OUTPUT_FILE "${resources}/DEPENDENCIES.txt"
                    COMMAND_ERROR_IS_FATAL ANY)
    # Homebrew receipts identify the exact sources for dynamically linked dependencies.
    execute_process(COMMAND "${BREW}" info --json=v2 --installed
                    OUTPUT_FILE "${resources}/HOMEBREW-RECEIPTS.json" COMMAND_ERROR_IS_FATAL ANY)
    file(STRINGS "${resources}/RUNTIME-SOURCES.txt" runtime_sources)
    set(dependencies llvm)
    foreach(library IN LISTS runtime_sources)
        file(REAL_PATH "${library}" library)
        if(library MATCHES "/Cellar/([^/]+)/")
            list(APPEND dependencies "${CMAKE_MATCH_1}")
        elseif(NOT library MATCHES "^/System/|^/usr/lib/")
            message(FATAL_ERROR "Cannot identify runtime dependency owner: ${library}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES dependencies)
    include("${SOURCE}/scripts/HomebrewNotices.cmake")
    foreach(package IN LISTS dependencies)
        execute_process(COMMAND "${BREW}" --prefix "${package}" RESULT_VARIABLE found
                        OUTPUT_VARIABLE prefix OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE error)
        if(NOT found EQUAL 0)
            message(FATAL_ERROR "Cannot collect ${package} license information: ${error}")
        endif()
        file(GLOB notices "${prefix}/LICENSE*" "${prefix}/COPYING*" "${prefix}/share/licenses/*"
                          "${prefix}/share/qtbase/LICENSES/*"
                          "${prefix}/share/doc/${package}/*" "${prefix}/share/qt/LICENSES/*")
        if(NOT notices)
            collect_source_notices("${package}" "${prefix}"
                "${resources}/share/codecairn/licenses/runtime/${package}"
                "${OUTPUT}/source-notice-cache")
        else()
            file(COPY ${notices} DESTINATION "${resources}/share/codecairn/licenses/runtime/${package}")
        endif()
    endforeach()
    file(GLOB_RECURSE binaries LIST_DIRECTORIES FALSE "${app}/Contents/MacOS/*"
         "${app}/Contents/Frameworks/*" "${app}/Contents/PlugIns/*")
    foreach(file IN LISTS binaries)
        if(IS_DIRECTORY "${file}")
            continue()
        endif()
        execute_process(COMMAND otool -L "${file}" RESULT_VARIABLE result
                        OUTPUT_VARIABLE libraries ERROR_VARIABLE error)
        if(result EQUAL 0)
            if(libraries MATCHES "/opt/homebrew/|/usr/local/|/Cellar/")
                message(FATAL_ERROR "Standalone app links to Homebrew: ${file}\n${libraries}")
            endif()
        elseif(NOT error MATCHES "not an object file|is not an object file")
            message(FATAL_ERROR "Cannot inspect ${file}: ${error}")
        endif()
    endforeach()
    # ARM64 executables require ad-hoc signatures after install-name rewriting.
    run(codesign --force --deep --sign - "${app}")
    run(codesign --verify --deep --strict "${app}")
    run("${CMAKE_COMMAND}" "-DAPP=${app}" "-DVERSION=${VERSION}" "-DTEST_DIRECTORY=${work}/runtime-check"
        -P "${SOURCE}/cmake/VerifyMacOSRuntime.cmake")
    set(artifact "${OUTPUT}/codecairn-${VERSION}-macos26-arm64-unsigned.zip")
    run(ditto -c -k --sequesterRsrc --keepParent "${app}" "${artifact}")
endif()
checksum("${artifact}")
release_work_complete("${work}")
message(STATUS "Release artifact: ${artifact}")
